{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tsmm/schemas/tsmm-binding.schema.json",
  "title": "TSMM Ecosystem Binding Schema",
  "description": "Machine-readable contract for aligning an external ecosystem vocabulary with TSMM abstractions, including mapping strength, behavioral expectations, and known limits.",
  "type": "object",
  "required": [
    "bindingId",
    "label",
    "targetEcosystem",
    "version",
    "bindingContract",
    "mappings"
  ],
  "properties": {
    "bindingId": {
      "$ref": "#/$defs/idString"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "targetEcosystem": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bindingContract": {
      "$ref": "#/$defs/bindingContract"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "maturity": {
      "type": "object",
      "required": [
        "status",
        "stability",
        "productionRecommendation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "experimental",
            "candidate",
            "supported",
            "deprecated"
          ]
        },
        "stability": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "stable",
            "sunset"
          ]
        },
        "productionRecommendation": {
          "type": "string",
          "enum": [
            "not-yet",
            "conditional",
            "yes",
            "no-new-adoption"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "idString": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tsmmType": {
      "type": "string",
      "enum": [
        "TrustDomain",
        "GovernanceAuthority",
        "TrustRegistry",
        "RegistryService",
        "Issuer",
        "Verifier",
        "Subject",
        "Agent",
        "Credential",
        "Policy",
        "AssuranceProfile",
        "EvidenceBundle",
        "Assessment",
        "TrustDecision",
        "Effect",
        "RelyingParty"
      ]
    },
    "guarantee": {
      "type": "object",
      "required": [
        "name",
        "status",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "not_supported"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": [
        "name",
        "impact"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "mitigation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "behavioralExpectation": {
      "type": "object",
      "required": [
        "behavior",
        "expectation"
      ],
      "properties": {
        "behavior": {
          "type": "string"
        },
        "expectation": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "bindingContract": {
      "type": "object",
      "required": [
        "sourceModel",
        "targetSystem",
        "bindingVersion",
        "guarantees",
        "limitations",
        "behavioralExpectations",
        "constraintSetRef"
      ],
      "properties": {
        "sourceModel": {
          "type": "string",
          "const": "TSMM"
        },
        "targetSystem": {
          "type": "string"
        },
        "bindingVersion": {
          "type": "string"
        },
        "guarantees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/guarantee"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/limitation"
          }
        },
        "behavioralExpectations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/behavioralExpectation"
          }
        },
        "constraintSetRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": [
        "externalConcept",
        "tsmmType",
        "bindingStrength"
      ],
      "properties": {
        "externalConcept": {
          "type": "string"
        },
        "tsmmType": {
          "$ref": "#/$defs/tsmmType"
        },
        "bindingStrength": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "composite"
          ]
        },
        "description": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedDocs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
